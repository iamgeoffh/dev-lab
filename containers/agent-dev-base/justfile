set shell := ["bash", "-euo", "pipefail", "-c"]

repo_root := justfile_directory()
context := repo_root / "containers/agent-dev-base"
image := "localhost/agent-dev-base:fedora-44"

# Build agent-dev-base with rootless Podman.
build:
    podman build \
        --tag "{{ image }}" \
        --file '{{ context }}/Containerfile' \
        '{{ context }}'

# Build and run the complete agent-dev-base smoke test.
test: build
    '{{ context }}/tests/smoke-test.sh' "{{ image }}"

